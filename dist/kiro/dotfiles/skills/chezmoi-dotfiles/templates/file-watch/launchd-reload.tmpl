#!/bin/bash
# config hash: {{ include "dot_config/chezmoi-watch/config.json.tmpl" | sha256sum }}
# Reload the launchd agent when config (and therefore WatchPaths) changes.
#
# Chezmoi source path: private_Library/LaunchAgents/run_onchange_after_reload-chezmoi-watch.tmpl
set -euo pipefail

PLIST="$HOME/Library/LaunchAgents/com.chezmoi.watch.plist"

if [ ! -f "$PLIST" ]; then
  echo "chezmoi-watch: plist not found, skipping reload" >&2
  exit 0
fi

launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
sleep 1
launchctl bootstrap "gui/$(id -u)" "$PLIST"
echo "chezmoi-watch: reloaded launchd agent"
