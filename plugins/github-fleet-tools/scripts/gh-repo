#!/usr/bin/env bash
#
# gh-repo — read a repo's contents/diffs over the API, without a local checkout.
#
# Consolidates two bounded, read-only (GET-only) reads behind one allowlistable command
# (`Bash(gh-repo:*)`): printing a file at a ref, and listing the changed files in a
# compare range. Each subcommand keeps the exact API call / jq filter of the script it
# replaces; only arg-parsing and the shared usage changed.
#
# Subcommands:
#   file    <ref> <path> [--repo owner/name]
#       Print a file's contents at a ref (commit/branch/tag) — the remote analog of
#       `git show <ref>:<path>`, via the GitHub contents API. (Caps at ~1 MB.)
#
#   compare <base>...<head> [--repo owner/name] [--json]
#       List a compare range's changed files + line stats, via the compare API — the
#       remote complement to a local diff-stat. For a PR's files use `gh pr view N
#       --json files` (this tool intentionally only does ref ranges, not PR numbers).
#
# Exit codes: 0 success; 1 not found / API error; 2 bad usage.
#
# Env: GH (override the gh binary), GH_HOST (force a hostname).
#
set -euo pipefail

GH="${GH:-gh}"
[[ -n "${GH_HOST:-}" ]] && export GH_HOST

usage() {
  cat >&2 <<'EOF'
usage: gh-repo <file|compare> [args]

  file    <ref> <path> [--repo owner/name]
      Print a file's contents at a ref (commit/branch/tag), via the contents API.

  compare <base>...<head> [--repo owner/name] [--json]
      List a compare range's changed files + line stats, via the compare API.

Env: GH (override the gh binary), GH_HOST (force a hostname).
EOF
}

# Resolve owner/name: explicit --repo wins, else the current repo. Validates owner/name.
resolve_repo_arg() {
  if [[ -z "$1" ]]; then
    "$GH" repo view --json nameWithOwner --jq .nameWithOwner
  else
    echo "$1"
  fi
}

# --- file <ref> <path> [--repo owner/name] — print a file at a ref (contents API) -----
cmd_file() {
  local ref="" path="" repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repo="${2:-}"; shift 2 ;;
      -*) echo "unknown argument: $1" >&2; exit 2 ;;
      *)
        if [[ -z "$ref" ]]; then ref="$1"
        elif [[ -z "$path" ]]; then path="$1"
        else echo "unexpected extra argument: $1" >&2; exit 2; fi
        shift ;;
    esac
  done

  if [[ -z "$ref" || -z "$path" ]]; then
    echo "usage: gh-repo file <ref> <path> [--repo owner/name]" >&2
    exit 2
  fi

  repo="$(resolve_repo_arg "$repo")"
  if ! [[ "$repo" =~ ^[^/]+/[^/]+$ ]]; then
    echo "--repo must be owner/name (got: $repo)" >&2
    exit 2
  fi

  # Fetch the contents entry. The API encoding is base64 for a file; a directory returns an
  # array (encoding empty) and a too-large file returns encoding "none".
  local resp
  resp="$("$GH" api "repos/$repo/contents/$path?ref=$ref" 2>/dev/null)" || {
    echo "not found: $path @ $ref in $repo (or API error)" >&2
    exit 1
  }

  local type
  type="$(printf '%s' "$resp" | jq -r 'if type=="array" then "dir" else (.type // "?") end')"
  if [[ "$type" != "file" ]]; then
    echo "not a file: $path @ $ref in $repo (type: $type)" >&2
    exit 1
  fi

  local encoding
  encoding="$(printf '%s' "$resp" | jq -r '.encoding // ""')"
  if [[ "$encoding" != "base64" ]]; then
    echo "cannot read $path @ $ref: contents API returned encoding '$encoding' (file likely >1 MB — use the blobs/raw API)" >&2
    exit 1
  fi

  printf '%s' "$resp" | jq -r '.content' | base64 -d
}

# --- compare <base>...<head> [--repo owner/name] [--json] — changed files for a ref
#     range (compare API). Ranges only; for a PR's files use `gh pr view N --json files`. --
cmd_compare() {
  local target="" repo="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --repo) repo="${2:-}"; shift 2 ;;
      -*) echo "unknown argument: $1" >&2; exit 2 ;;
      *)
        if [[ -z "$target" ]]; then target="$1"; else echo "unexpected extra argument: $1" >&2; exit 2; fi
        shift ;;
    esac
  done

  if [[ -z "$target" ]]; then
    echo "usage: gh-repo compare <base>...<head> [--repo owner/name] [--json]" >&2
    exit 2
  fi

  repo="$(resolve_repo_arg "$repo")"
  if ! [[ "$repo" =~ ^[^/]+/[^/]+$ ]]; then
    echo "--repo must be owner/name (got: $repo)" >&2
    exit 2
  fi

  if [[ "$target" != *...* ]]; then
    echo "argument must be a 'base...head' range (got: $target). For a PR's files use 'gh pr view N --json files'." >&2
    exit 2
  fi
  # URI-encode each ref before interpolating into the compare path — branch names
  # often contain '/' (e.g. feature/foo), which would otherwise malform the path and 404.
  # The literal '...' separator is kept between the two encoded refs.
  local base head range
  base="$(jq -rn --arg s "${target%%...*}" '$s|@uri')"
  head="$(jq -rn --arg s "${target##*...}" '$s|@uri')"
  range="${base}...${head}"

  if [[ "$json" == "1" ]]; then
    "$GH" api "repos/$repo/compare/$range" \
      --jq '[.files[] | { filename, status, additions, deletions }]'
  else
    "$GH" api "repos/$repo/compare/$range" \
      --jq '.files[] | "\(.status)\t+\(.additions)\t-\(.deletions)\t\(.filename)"'
  fi
}

sub="${1:-}"
[[ $# -gt 0 ]] && shift || true
case "$sub" in
  file)    cmd_file "$@" ;;
  compare) cmd_compare "$@" ;;
  "")      usage; exit 0 ;;
  *)       echo "unknown subcommand: $sub" >&2; usage; exit 2 ;;
esac
