#!/usr/bin/env bash
# Generic file-watch handler for chezmoi.
# Reads config from ~/.config/chezmoi-watch/config.json and runs every
# configured command. Designed to be invoked by launchd (macOS) or
# systemd (Linux) when any watched path changes.
#
# Commands are expected to be fast and idempotent. Running all of them
# on every trigger is intentional — avoids needing to detect which
# specific path changed.
#
# Chezmoi source path: dot_local/bin/executable_chezmoi-watch-handler

set -euo pipefail

CONFIG="${HOME}/.config/chezmoi-watch/config.json"

if [ ! -f "$CONFIG" ]; then
  echo "chezmoi-watch-handler: config not found at $CONFIG" >&2
  exit 0
fi

# Parse JSON config and run each command.
# Uses python3 (available on macOS and most Linux) to avoid jq dependency.
python3 -c "
import json, subprocess, sys

with open('$CONFIG') as f:
    entries = json.load(f)

if not entries:
    sys.exit(0)

failed = 0
for entry in entries:
    name = entry.get('name', entry.get('watch', 'unknown'))
    cmd = entry.get('command', '')
    if not cmd:
        continue
    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    if result.returncode != 0:
        print(f'chezmoi-watch: {name} failed (exit {result.returncode})', file=sys.stderr)
        if result.stderr:
            print(result.stderr.rstrip(), file=sys.stderr)
        failed += 1
    else:
        if result.stderr:
            print(result.stderr.rstrip(), file=sys.stderr)

sys.exit(1 if failed else 0)
"
