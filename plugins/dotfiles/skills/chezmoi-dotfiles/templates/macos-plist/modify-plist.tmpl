#!/bin/bash
# Chezmoi modify_ script for partial plist management.
# Merges managed keys into the current target plist.
#
# Rename this file to: modify_private_com.example.App.plist.tmpl
# Update the managed plist path below to match your app.
#
# Chezmoi source path: private_Library/private_Preferences/modify_private_com.example.App.plist.tmpl
set -euo pipefail
exec python3 "{{ .chezmoi.sourceDir }}/dot_local/bin/executable_plist-merge" \
  "{{ .chezmoi.sourceDir }}/private_Library/private_Preferences/private_com.example.App.managed.plist"
