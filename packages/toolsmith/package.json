  "description": "Deterministic lifecycle CLI for toolsmith purpose-built agent tools: approve (staged→live promotion), verify (hash-pin integrity), lint (proposal gate), list, analyze",
  "license": "MIT",
  "author": "Mike North",
  "type": "module",
  "bin": {
    "toolsmith": "./dist/toolsmith.mjs"
  },
