#!/bin/bash
# config hash: {{ include "dot_config/chezmoi-watch/config.json.tmpl" | sha256sum }}
# Reload systemd path unit when config (and therefore watched paths) changes.
#
# Chezmoi source path: dot_config/systemd/user/run_onchange_after_reload-chezmoi-watch.tmpl
set -euo pipefail

{{ if eq .chezmoi.os "linux" -}}
systemctl --user daemon-reload
systemctl --user enable --now chezmoi-watch.path
echo "chezmoi-watch: enabled and started systemd path unit"
{{- else -}}
# Not on Linux — nothing to do.
exit 0
{{- end }}
