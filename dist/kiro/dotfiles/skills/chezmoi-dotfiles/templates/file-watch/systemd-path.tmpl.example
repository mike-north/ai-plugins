{{- /*
  Linux systemd path unit for chezmoi file watching.
  Deployed to: ~/.config/systemd/user/chezmoi-watch.path

  PathChanged uses inotify — zero cost while idle, kernel-level notification.
  Add one PathChanged= per watched file. Must match entries in config.json.

  Chezmoi source path: dot_config/systemd/user/chezmoi-watch.path.tmpl
*/ -}}
{{- if eq .chezmoi.os "linux" -}}
[Unit]
Description=Watch files for chezmoi reverse sync

[Path]
# Add one PathChanged= per watched file. Must match config.json entries.
PathChanged={{ .chezmoi.homeDir }}/.config/example-app/config.json

[Install]
WantedBy=default.target
{{- end }}
