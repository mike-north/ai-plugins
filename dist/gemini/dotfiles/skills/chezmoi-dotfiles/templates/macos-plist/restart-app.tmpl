#!/bin/bash
# Chezmoi run_onchange_ script to restart the app when managed keys change.
# The sha256sum hash causes chezmoi to re-run this only when the managed
# plist content actually changes.
#
# Rename this file to: run_onchange_after_modify_private_com.example.App.plist.tmpl
# Update:
#   1. The include path to match your managed plist filename
#   2. The PLIST, MANAGED paths to match your app's bundle ID
#   3. The osascript app name and open -a name
#
# Chezmoi source path: private_Library/private_Preferences/run_onchange_after_modify_private_com.example.App.plist.tmpl

# managed keys hash: {{ include "private_Library/private_Preferences/private_com.example.App.managed.plist" | sha256sum }}
set -euo pipefail

PLIST="$HOME/Library/Preferences/com.example.App.plist"
MERGE_TOOL="{{ .chezmoi.sourceDir }}/dot_local/bin/executable_plist-merge"
MANAGED="{{ .chezmoi.sourceDir }}/private_Library/private_Preferences/private_com.example.App.managed.plist"

# Quit app — it will flush its in-memory state to disk via cfprefsd,
# potentially overwriting the plist that chezmoi's modify_ script just wrote.
osascript -e 'tell application "Example App" to quit' 2>/dev/null || true
sleep 2

# Re-apply managed keys to recover from the cfprefsd overwrite.
python3 "$MERGE_TOOL" "$MANAGED" < "$PLIST" > "${PLIST}.tmp" && mv "${PLIST}.tmp" "$PLIST"

open -a "Example App"
