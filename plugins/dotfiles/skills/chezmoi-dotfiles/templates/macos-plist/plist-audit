#!/usr/bin/env python3
"""Audit all keys in a macOS plist file to help decide which to manage.

Usage:
    plist-audit <plist-file>
    plist-audit --classify <plist-file>

Reads a binary or XML plist and prints every top-level key with its type
and a truncated preview of the value.

With --classify, applies heuristics to categorize each key as likely
"state" (noise — timestamps, window frames, caches) or "settings"
(user preferences worth managing). This is a starting point, not a
final answer — always review the output.

Heuristic patterns for state keys:
    - NSStatusItem*, NSWindow Frame*  — UI state
    - SU*                             — Sparkle update framework
    - *lastEncountered, *LastCheck*   — timestamps
    - displayCache, recentDocuments   — ephemeral caches
    - Paddle-*, fld                   — license/activation data
    - *Version (install/last)         — version tracking
    - *Notified, *Shown, *Before     — one-time flags
"""

import plistlib
import re
import sys

# Patterns that strongly suggest a key is state/noise, not a user setting.
STATE_PATTERNS = [
    (r"^NSStatusItem", "UI state (menu bar position)"),
    (r"^NSWindow Frame", "UI state (window frame)"),
    (r"^NS.*Rect$", "UI state (geometry)"),
    (r"^SU", "Sparkle update framework"),
    (r"^Paddle-", "License/activation data"),
    (r"^fld$", "Encrypted license data"),
    (r"lastEncountered", "Timestamp (ephemeral)"),
    (r"LastCheck", "Timestamp (ephemeral)"),
    (r"lastModified", "Timestamp (ephemeral)"),
    (r"^displayCache$", "Display state cache"),
    (r"^recentDocuments$", "Recent documents list"),
    (r"^installVersion$", "Version tracking"),
    (r"^lastVersion$", "Version tracking"),
    (r"Notified$", "One-time notification flag"),
    (r"Shown$", "One-time UI flag"),
    (r"LaunchedBefore$", "One-time launch flag"),
    (r"^kSecCSMatch", "Code signing state"),
]


def type_name(val):
    """Human-readable type name for a plist value."""
    t = type(val).__name__
    mapping = {
        "bool": "bool",
        "int": "int",
        "float": "float",
        "str": "string",
        "bytes": "data",
        "datetime": "date",
        "dict": "dict",
        "list": "array",
    }
    return mapping.get(t, t)


def preview(val, max_len=80):
    """Truncated string preview of a value."""
    s = repr(val)
    if len(s) > max_len:
        return s[: max_len - 3] + "..."
    return s


def classify_key(key):
    """Return (category, reason) for a key based on heuristics."""
    for pattern, reason in STATE_PATTERNS:
        if re.search(pattern, key):
            return ("state", reason)
    return ("settings", "")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(0)

    classify = False
    plist_path = sys.argv[1]
    if sys.argv[1] == "--classify":
        classify = True
        if len(sys.argv) < 3:
            print("Usage: plist-audit --classify <plist-file>", file=sys.stderr)
            sys.exit(1)
        plist_path = sys.argv[2]

    with open(plist_path, "rb") as f:
        data = plistlib.load(f)

    if not isinstance(data, dict):
        print("Error: plist root is not a dictionary", file=sys.stderr)
        sys.exit(1)

    if classify:
        settings_keys = []
        state_keys = []
        for key in sorted(data.keys()):
            category, reason = classify_key(key)
            if category == "state":
                state_keys.append((key, reason))
            else:
                settings_keys.append(key)

        print(f"=== LIKELY SETTINGS ({len(settings_keys)} keys) ===")
        print("These are probably user preferences worth managing:\n")
        for key in settings_keys:
            val = data[key]
            print(f"  {key} ({type_name(val)}): {preview(val)}")

        print(f"\n=== LIKELY STATE ({len(state_keys)} keys) ===")
        print("These are probably noise — exclude from managed keys:\n")
        for key, reason in state_keys:
            val = data[key]
            print(f"  {key} ({type_name(val)}): {reason}")

        print(f"\nTotal: {len(data)} keys — {len(settings_keys)} settings, {len(state_keys)} state")
        print("\nReview carefully! Heuristics can miscategorize keys.")
        print("Use 'plist-extract' to create the managed plist from your chosen keys.")
    else:
        print(f"Keys in {plist_path} ({len(data)} total):\n")
        for key in sorted(data.keys()):
            val = data[key]
            print(f"  {key} ({type_name(val)}): {preview(val)}")


if __name__ == "__main__":
    main()
